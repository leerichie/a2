[Unit]
Description=a2 controlled content service
After=network.target

[Service]
Type=simple
User=a2
Group=a2
WorkingDirectory=/opt/a2-content
EnvironmentFile=/etc/a2-content.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/a2-content/data

[Install]
WantedBy=multi-user.target
